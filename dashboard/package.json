{
  "name": "twonk-watch-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "tsc --noEmit && vite build",
    "build:edge": "tsc --noEmit && VITE_API_BASE=/twonkwatch vite build --base=/twonkwatch/ --outDir=dist-edge-tmp && rm -rf dist-edge && mkdir -p dist-edge && mv dist-edge-tmp dist-edge/twonkwatch",
    "preview": "vite preview",
    "serve": "node server.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
